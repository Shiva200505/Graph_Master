// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String    @unique @db.VarChar(15)
  name       String?   @db.VarChar(100)
  email      String?   @db.VarChar(100)
  otp        String?   @db.VarChar(6)
  otpExpiry  DateTime? @map("otp_expiry")
  isVerified Boolean   @default(false) @map("is_verified")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

model Dealer {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                    @db.VarChar(100)
  phone            String                    @db.VarChar(15)
  email            String?                   @unique @db.VarChar(100)
  passwordHash     String?                   @map("password_hash") @db.VarChar(255)
  address          String                    @db.Text
  location         Unsupported("geography")? // PostGIS geography type
  coverageRadiusKm Decimal                   @default(10.0) @map("coverage_radius_km") @db.Decimal(5, 2)
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  inventory DealerInventory[]
  orders    Order[]

  @@index([location], type: Gist)
  @@index([isActive])
  @@map("dealers")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  category    String?  @db.VarChar(50)
  unit        String?  @db.VarChar(20)
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory  DealerInventory[]
  orderItems OrderItem[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model DealerInventory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealerId  String   @map("dealer_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  dealer  Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dealerId, productId])
  @@index([dealerId])
  @@index([productId])
  @@index([quantity])
  @@map("dealer_inventory")
}

model Order {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber        String                   @unique @map("order_number") @db.VarChar(20)
  userId             String?                  @map("user_id") @db.Uuid
  dealerId           String                   @map("dealer_id") @db.Uuid
  customerName       String                   @map("customer_name") @db.VarChar(100)
  customerPhone      String                   @map("customer_phone") @db.VarChar(15)
  deliveryAddress    String                   @map("delivery_address") @db.Text
  deliveryLocation   Unsupported("geography")? @map("delivery_location")
  fulfillmentType    String                   @map("fulfillment_type") @db.VarChar(20)
  deliveryDistanceKm Decimal?                 @map("delivery_distance_km") @db.Decimal(8, 2)
  deliveryCharge     Decimal                  @default(0) @map("delivery_charge") @db.Decimal(10, 2)
  subtotal           Decimal                  @db.Decimal(10, 2)
  total              Decimal                  @db.Decimal(10, 2)
  status             String                   @default("pending") @db.VarChar(20)
  paymentId          String?                  @map("payment_id") @db.Uuid
  paymentStatus      String?                  @map("payment_status") @db.VarChar(20)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  dealer  Dealer      @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([dealerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  unit        String?  @db.VarChar(20)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String   @unique @map("order_id") @db.Uuid
  transactionId         String?  @unique @map("transaction_id") @db.VarChar(100)
  merchantTransactionId String?  @unique @map("merchant_transaction_id") @db.VarChar(100)
  amount                Decimal  @db.Decimal(10, 2)
  status                String   @db.VarChar(20)
  paymentMethod         String?  @map("payment_method") @db.VarChar(50)
  responseData          Json?    @map("response_data")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model Location {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String                   @db.VarChar(100)
  district  String?                  @db.VarChar(50)
  state     String?                  @db.VarChar(50)
  location  Unsupported("geography")? // PostGIS geography type
  createdAt DateTime                 @default(now()) @map("created_at")

  @@index([name])
  @@index([district])
  @@index([location], type: Gist)
  @@map("locations")
}

model Admin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255) // bcrypt hashed
  name      String   @db.VarChar(100)
  role      String   @default("admin") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("admins")
}
