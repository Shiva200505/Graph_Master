generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String    @unique @db.VarChar(15)
  name       String?   @db.VarChar(100)
  email      String?   @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isVerified Boolean   @default(false) @map("is_verified")
  otp        String?   @db.VarChar(6)
  otpExpiry  DateTime? @map("otp_expiry")
  orders     Order[]

  @@map("users")
}

model Dealer {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                    @db.VarChar(100)
  phone            String                    @db.VarChar(15)
  email            String?                   @unique @db.VarChar(100)
  address          String
  location         Unsupported("geography")?
  coverageRadiusKm Decimal                   @default(10.0) @map("coverage_radius_km") @db.Decimal(5, 2)
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  passwordHash     String?                   @map("password_hash") @db.VarChar(255)
  inventory        DealerInventory[]
  orders           Order[]
  productRequests  ProductRequest[]

  @@index([location], type: Gist)
  @@index([isActive])
  @@map("dealers")
}

model Product {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                @db.VarChar(200)
  description          String?
  category             String?               @db.VarChar(50)
  unit                 String?               @db.VarChar(20)
  basePrice            Decimal               @map("base_price") @db.Decimal(10, 2)
  imageUrl             String?               @map("image_url")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  inventory            DealerInventory[]
  orderItems           OrderItem[]
  recommendationEvents RecommendationEvent[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model DealerInventory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealerId  String   @map("dealer_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dealerId, productId])
  @@index([dealerId])
  @@index([productId])
  @@index([quantity])
  @@map("dealer_inventory")
}

model Order {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber        String                    @unique @map("order_number") @db.VarChar(20)
  userId             String?                   @map("user_id") @db.Uuid
  dealerId           String                    @map("dealer_id") @db.Uuid
  customerName       String                    @map("customer_name") @db.VarChar(100)
  customerPhone      String                    @map("customer_phone") @db.VarChar(15)
  deliveryAddress    String                    @map("delivery_address")
  deliveryLocation   Unsupported("geography")? @map("delivery_location")
  fulfillmentType    String                    @map("fulfillment_type") @db.VarChar(20)
  deliveryDistanceKm Decimal?                  @map("delivery_distance_km") @db.Decimal(8, 2)
  deliveryCharge     Decimal                   @default(0) @map("delivery_charge") @db.Decimal(10, 2)
  subtotal           Decimal                   @db.Decimal(10, 2)
  total              Decimal                   @db.Decimal(10, 2)
  status             String                    @default("pending") @db.VarChar(20)
  paymentId          String?                   @map("payment_id") @db.Uuid
  paymentStatus      String?                   @map("payment_status") @db.VarChar(20)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  items              OrderItem[]
  dealer             Dealer                    @relation(fields: [dealerId], references: [id])
  user               User?                     @relation(fields: [userId], references: [id])
  payment            Payment?

  @@index([userId])
  @@index([dealerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  unit        String?  @db.VarChar(20)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String   @unique @map("order_id") @db.Uuid
  transactionId         String?  @unique @map("transaction_id") @db.VarChar(100)
  merchantTransactionId String?  @unique @map("merchant_transaction_id") @db.VarChar(100)
  amount                Decimal  @db.Decimal(10, 2)
  status                String   @db.VarChar(20)
  paymentMethod         String?  @map("payment_method") @db.VarChar(50)
  responseData          Json?    @map("response_data")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  order                 Order    @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model Location {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String                    @db.VarChar(100)
  district  String?                   @db.VarChar(50)
  state     String?                   @db.VarChar(50)
  location  Unsupported("geography")?
  createdAt DateTime                  @default(now()) @map("created_at")

  @@index([name])
  @@index([district])
  @@index([location], type: Gist)
  @@map("locations")
}

model Admin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  role      String   @default("admin") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("admins")
}

model RecommendationEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String   @map("event_type") @db.VarChar(20)
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(100)
  productId String   @map("product_id") @db.Uuid
  dealerId  String?  @map("dealer_id") @db.Uuid
  userLat   Decimal? @map("user_lat") @db.Decimal(10, 7)
  userLng   Decimal? @map("user_lng") @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("recommendation_events")
}

model ProductAssociation {
  productA          String   @map("product_a") @db.Uuid
  productB          String   @map("product_b") @db.Uuid
  coOccurrenceCount Int      @default(0) @map("co_occurrence_count")
  confidence        Decimal  @default(0) @db.Decimal(5, 4)
  lift              Decimal  @default(0) @db.Decimal(8, 4)
  lastComputed      DateTime @default(now()) @map("last_computed")

  @@id([productA, productB])
  @@index([productA])
  @@map("product_associations")
}

model ProductRequest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealerId       String   @map("dealer_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(200)
  category       String   @db.VarChar(50)
  unit           String   @db.VarChar(20)
  estimatedPrice Decimal  @map("estimated_price") @db.Decimal(10, 2)
  description    String?  @db.Text
  reason         String?  @db.Text
  status         String   @default("pending") @db.VarChar(20)
  adminNote      String?  @map("admin_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([status])
  @@map("product_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
